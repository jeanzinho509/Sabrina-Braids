# Default for real hosting: neon. Local tests: npm run setup:local.
DATABASE_DRIVER=neon
# Connection string from Neon. Never commit .env.
DATABASE_URL=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
# Public origin; use https://your-domain.example in production.
AUTH_URL=http://localhost:4000
ADMIN_EMAILS=jean.dev.com@gmail.com,estimesabrina15@gmail.com
PORT=4000
# Keep 0 locally. Set only after verifying the hosting provider's proxy chain.
TRUST_PROXY_HOPS=0
